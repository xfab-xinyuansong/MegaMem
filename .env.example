# ============================================================================
# MegaMem environment configuration template
# Copy this file to `.env` and fill in your own credentials.
#   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
# ============================================================================

# --- General chat API --------------------------------------------------------
# All hosted chat aliases resolve through this general model gateway.
LLM_API_BASE=YOUR_LLM_API_BASE
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_CHAT_MODEL=YOUR_CHAT_MODEL
LLM_JUDGE_MODEL=YOUR_JUDGE_MODEL

# Optional: explicit model-alias YAML when not running from the repository root.
# MEGAMEM_MODELS_CONFIG=/absolute/path/to/models.yaml

# Optional client controls.
LLM_TIMEOUT_SECONDS=120
LLM_POOL_MAX=256
LLM_POOL_KEEPALIVE=128

# --- Remote memory service --------------------------------------------------
# Used only by MemoryClient remote mode.
MEGAMEM_SERVER_URL=http://localhost:8000
MEGAMEM_API_KEY=YOUR_MEGAMEM_API_KEY

# Optional secondary endpoint for extraction-heavy runs. Leave disabled unless
# you intentionally route selected calls to a second general API endpoint.
USE_SECONDARY_LLM_API=false
SECONDARY_LLM_API_BASE=YOUR_SECONDARY_LLM_API_BASE
SECONDARY_LLM_API_KEY=YOUR_SECONDARY_LLM_API_KEY
SECONDARY_LLM_MODEL=YOUR_SECONDARY_LLM_MODEL

# --- Embeddings -------------------------------------------------------------
# Default is a local sentence-transformers model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Set to 0 to route embeddings through the general model gateway.
MEGAMEM_LOCAL_EMBEDDING=1
# EMBEDDING_API_BASE=https://your-endpoint.example/v1
# EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY

# --- Data locations ---------------------------------------------------------
# Root directory holding corpora, questions, manifests, and built indices.
DATA_DIR=./data

# --- Optional external integration frameworks ------------------------------
# Only fill these when using the corresponding authorized external adapters.
# MEM0_API_KEY=YOUR_MEM0_KEY
# ZEP_API_KEY=YOUR_ZEP_KEY
